---
import LandingPage from "../components/LandingPage";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-pt-7 scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Declare your tools once. Install, update, and manage them from a keyboard-friendly terminal interface on Linux, macOS, and Windows."
    />
    <meta name="theme-color" content="#f6f4ee" />
    <meta
      property="og:title"
      content="Settupper — Your next machine. Already set up."
    />
    <meta
      property="og:description"
      content="One configuration file. A terminal full of possibilities. Meet the declarative package manager for your next fresh start."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Settupper — Your next machine. Already set up.</title>
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <LandingPage client:load />
  </body>
</html>
